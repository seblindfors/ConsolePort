<Ui>
	<Script file="Bagflyout.lua"/>
	<Script file="Toolbar.lua"/>

	<Button name="CPBagFlyoutButtonTemplate" mixin="CPBagFlyoutButton" registerForClicks="AnyUp" virtual="true">
		<Size x="40" y="40"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Border" file="Interface\Common\WhiteIconFrame" setAllPoints="true" hidden="true"/>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD" setAllPoints="true"/>
		<PushedTexture file="Interface\Buttons\UI-Quickslot-Depress" setAllPoints="true"/>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Button name="CPBagFlyoutPopoutTemplate" mixin="CPBagFlyoutPopout" registerForClicks="AnyUp" motionScriptsWhileDisabled="true" virtual="true">
		<Size x="26" y="11"/>
		<NormalTexture parentKey="NormalTexture">
			<Size x="26" y="11"/>
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</NormalTexture>
		<HighlightTexture parentKey="HighlightTexture" alphaMode="ADD">
			<Size x="26" y="11"/>
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</HighlightTexture>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnEnable>
				self:SetAlpha(0.5);
			</OnEnable>
			<OnDisable>
				self:SetAlpha(0.25);
			</OnDisable>
		</Scripts>
	</Button>

	<Frame name="CPBagFlyout" mixin="CPBagFlyout" clampedToScreen="true" hidden="true" virtual="true">
		<Size x="64" y="64"/>
		<KeyValues>
			<KeyValue key="ignoreInLayout" value="true" type="boolean"/>
		</KeyValues>
		<Frames>
			<Frame parentKey="Border" scale="0.5" useParentLevel="true" inherits="NineSlicePanelTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" y="-10"/>
					<Anchor point="BOTTOMRIGHT" y="-10"/>
				</Anchors>
			</Frame>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Empty" inherits="GameFontDisableSmall" justifyH="CENTER">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>

	<Button name="CPToolbarMicroButton" mixin="CPMicroButton" motionScriptsWhileDisabled="true" virtual="true">
		<Size x="32" y="40"/>
		<NormalTexture parentKey="NormalTexture">
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</NormalTexture>
		<PushedTexture parentKey="PushedTexture">
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</PushedTexture>
		<HighlightTexture parentKey="HighlightTexture">
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</HighlightTexture>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background">
					<Size x="32" y="41"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
				<Texture parentKey="PushedBackground" hidden="true">
					<Size x="32" y="41"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="FlashBorder" setAllPoints="true" alphaMode="BLEND" hidden="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnEnter" inherit="append"/>
			<OnLeave method="OnLeave" inherit="append"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnable>
				self:SetAlpha(1);
			</OnEnable>
			<OnDisable>
				self:SetAlpha(0.5);
			</OnDisable>
			<OnLeave inherit="append">
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Button>

	<Frame name="CPToolbarDivider" virtual="true">
		<Size x="16" y="40"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="BattleBar-ButtonBG-Divider">
					<Size x="12" y="40"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="CPToolbar" virtual="true" clampedToScreen="true" movable="true" mixin="CPToolbar">
		<Size x="96" y="32"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnDragStart method="StartMoving"/>
			<OnDragStop method="StopMovingOrSizing"/>
		</Scripts>
		<Frames>
			<Button parentKey="Notch" name="$parentToggle" mixin="CPToolbarNotch" registerForClicks="AnyDown" alpha="0">
				<Size x="52" y="24"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<NormalTexture parentKey="NormalTexture">
					<Size x="24" y="52"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</NormalTexture>
				<PushedTexture parentKey="PushedTexture">
					<Size x="24" y="52"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</PushedTexture>
				<HighlightTexture parentKey="HighlightTexture" alphaMode="BLEND">
					<Size x="24" y="52"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</HighlightTexture>
				<Scripts>
					<OnLoad method="OnLoad"/>
					<OnClick method="OnClick"/>
					<OnEnter method="OnEnter"/>
					<OnLeave method="OnLeave"/>
				</Scripts>
			</Button>
			<Frame parentKey="Menu" name="$parentMenu" frameStrata="HIGH" clampedToScreen="true" hidden="true">
				<Size x="300" y="120"/>
				<Frames>
					<Frame parentKey="Border" useParentLevel="true" inherits="NineSlicePanelTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" y="-10"/>
							<Anchor point="BOTTOMRIGHT" y="-10"/>
						</Anchors>
					</Frame>
					<Frame parentKey="Grid" inherits="GridLayoutFrame" scale="1.5">
						<Size x="300" y="40"/>
						<KeyValues>
							<KeyValue key="childXPadding" value="1" type="number"/>
							<KeyValue key="childYPadding" value="2" type="number"/>
							<KeyValue key="stride" value="100" type="number"/>
							<KeyValue key="isHorizontal" value="true" type="boolean"/>
							<KeyValue key="layoutFramesGoingRight" value="true" type="boolean"/>
							<KeyValue key="alwaysUpdateLayout" value="true" type="boolean"/>
						</KeyValues>
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<Frames>
							<Button parentKey="ExitVehicle" inherits="CPToolbarMicroButton">
								<KeyValues>
									<KeyValue key="layoutIndex" value="-5" type="number"/>
									<KeyValue key="normalAtlas" value="poi-traveldirections-arrow2" type="string"/>
									<KeyValue key="highlightAtlas" value="poi-traveldirections-arrow2" type="string"/>
								</KeyValues>
							</Button>
							<Button parentKey="Eye" inherits="CPToolbarMicroButton">
								<NormalTexture parentKey="NormalTexture" alphaMode="BLEND" alpha="1" rotation="90">
									<Size x="32" y="16"/>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</NormalTexture>
								<PushedTexture parentKey="PushedTexture" alphaMode="BLEND" alpha="1" rotation="90">
									<Size x="32" y="16"/>
									<Anchors>
										<Anchor point="CENTER" x="1" y="-1"/>
									</Anchors>
								</PushedTexture>
								<KeyValues>
									<KeyValue key="layoutIndex" value="-4" type="number"/>
								</KeyValues>
							</Button>
							<Button parentKey="Config" inherits="CPToolbarMicroButton">
								<KeyValues>
									<KeyValue key="layoutIndex" value="-3" type="number"/>
									<KeyValue key="normalAtlas" value="Barbershop-32x32" type="string"/>
									<KeyValue key="highlightAtlas" value="Barbershop-32x32" type="string"/>
								</KeyValues>
							</Button>
							<Frame parentKey="Divider1" inherits="CPToolbarDivider">
								<KeyValues>
									<KeyValue key="layoutIndex" value="-1" type="number"/>
								</KeyValues>
							</Frame>
							<Frame parentKey="Divider2" inherits="CPToolbarDivider">
								<KeyValues>
									<KeyValue key="layoutIndex" value="100" type="number"/>
								</KeyValues>
							</Frame>
							<Frame parentKey="Flyout" name="ConsolePortToolbarBagFlyout" inherits="CPBagFlyout"/>
						</Frames>
					</Frame>
				</Frames>
			</Frame>
		</Frames>
	</Frame>

</Ui>
